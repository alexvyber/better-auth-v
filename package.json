{
  "name": "better-auth-v-conformance",
  "private": true,
  "type": "module",
  "scripts": {
    "build:bridge": "mkdir -p build && V_C_ERROR_BUG_REPORT_DISABLED=1 \"${V:-v}\" -o build/auth-bridge cmd/bridge",
    "test": "pnpm build:bridge && pnpm build:mongo && vitest run",
    "typecheck": "tsc --noEmit",
    "upstream:fetch": "node scripts/fetch-upstream.mjs",
    "upstream:import": "node scripts/import-upstream.mjs",
    "upstream:inventory": "node scripts/inventory-upstream.mjs",
    "postgres:setup": "node scripts/build-test-postgres.mjs",
    "mongo:setup": "node scripts/build-test-mongo.mjs",
    "build:mongo": "mkdir -p build && V_C_ERROR_BUG_REPORT_DISABLED=1 \"${V:-v}\" -d mongodb -o build/mongo-auth-bridge cmd/bridge && V_C_ERROR_BUG_REPORT_DISABLED=1 \"${V:-v}\" -d mongodb -o build/mongo-command cmd/mongo"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.15",
    "@better-auth/utils": "0.5.1",
    "@better-fetch/fetch": "1.3.3",
    "@noble/hashes": "2.4.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.17",
    "better-auth": "1.7.15",
    "better-call": "1.4.4",
    "jose": "6.2.15",
    "msw": "2.14.6",
    "oauth2-mock-server": "9.0.0",
    "react": "19.2.7",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "zod": "4.6.7"
  }
}
